package pages

import (
	"github.com/hi-naresh/unsolved/internal/views/layouts"
	"github.com/hi-naresh/unsolved/internal/views/partials"
)

// ProblemDomainOption is one domain in a select.
type ProblemDomainOption struct {
	ID   string
	Slug string
	Name string
}

// ProblemsIndexView is /problems: the filter form and one page of results.
type ProblemsIndexView struct {
	State   string
	Domain  string
	Sort    string
	Domains []ProblemDomainOption
	List    partials.ProblemRowsView
}

templ ProblemsIndex(v ProblemsIndexView) {
	@layouts.Base("Problems") {
		<h1 class="text-2xl font-semibold">Problems</h1>
		<form method="get" action="/problems" class="mt-4 flex flex-wrap items-end gap-3 text-sm">
			<label>
				<span class="block text-stone-600">State</span>
				<select name="state" class="field">
					<option value="" selected?={ v.State == "" }>Any</option>
					for _, s := range []string{"open", "solved", "invalid"} {
						<option value={ s } selected?={ v.State == s }>{ partials.ProblemStateLabel(s) }</option>
					}
				</select>
			</label>
			<label>
				<span class="block text-stone-600">Domain</span>
				<select name="domain" class="field">
					<option value="" selected?={ v.Domain == "" }>Any</option>
					for _, d := range v.Domains {
						<option value={ d.Slug } selected?={ v.Domain == d.Slug }>{ d.Name }</option>
					}
				</select>
			</label>
			<label>
				<span class="block text-stone-600">Sort</span>
				<select name="sort" class="field">
					<option value="top" selected?={ v.Sort != "new" }>Top</option>
					<option value="new" selected?={ v.Sort == "new" }>New</option>
				</select>
			</label>
			<button type="submit" class="btn">Filter</button>
		</form>
		<section class="mt-6">
			@partials.ProblemList(v.List)
		</section>
	}
}
