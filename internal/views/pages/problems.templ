package pages

import "github.com/hi-naresh/unsolved/internal/views/partials"

// ProblemDomainOption is one domain in a select.
type ProblemDomainOption struct {
	ID   string
	Slug string
	Name string
}

// ProblemsIndexView is /problems: filters and one page of results.
type ProblemsIndexView struct {
	State   string
	Domain  string
	Sort    string
	Domains []ProblemDomainOption
	List    partials.ProblemRowsView
}

func problemsTab(v ProblemsIndexView) string {
	switch {
	case v.State == "solved" || v.State == "invalid":
		return v.State
	case v.State == "open" && v.Sort != "new":
		return "open"
	case v.Sort == "new":
		return "new"
	}
	return "top"
}

func problemsHeading(v ProblemsIndexView) (string, string) {
	name := ""
	for _, d := range v.Domains {
		if d.Slug == v.Domain {
			name = d.Name
		}
	}
	switch problemsTab(v) {
	case "solved":
		if name != "" {
			return "Solved in " + name, "Problems the community has cracked."
		}
		return "Solved problems", "Problems the community has cracked, and how."
	case "new":
		if name != "" {
			return "New in " + name, "The latest problems, newest first."
		}
		return "New problems", "The latest problems, newest first."
	case "invalid":
		return "Invalid problems", "Kept for the record."
	}
	if name != "" {
		return name, "Problems in " + name + ", ranked by the community."
	}
	return "Problems", "Every problem, ranked by the community."
}

templ ProblemsIndex(v ProblemsIndexView) {
	{{ h, sub := problemsHeading(v) }}
	@Explore(ExploreView{
		Title:   h,
		Heading: h,
		Sub:     sub,
		Tab:     problemsTab(v),
		Domain:  v.Domain,
		Domains: v.Domains,
		List:    v.List,
	})
}
