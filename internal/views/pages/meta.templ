package pages

import (
	"github.com/hi-naresh/unsolved/internal/views/layouts"
	"github.com/hi-naresh/unsolved/internal/views/partials"
)

// MetaBoard is /meta: problems about Unsolved itself, by score.
templ MetaBoard(list partials.ProblemRowsView) {
	@layouts.Base("Meta") {
		<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="kicker">Meta board</p>
				<h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Make Unsolved better</h1>
				<p class="mt-2 max-w-lg text-[15px] text-stone-600">Problems with Unsolved itself. Same rules as everywhere else: describe what happens today and what goes wrong, and vote on what matters.</p>
			</div>
			<a href="/about" class="btn-secondary shrink-0 self-start sm:self-auto">How it works</a>
		</header>
		<section class="mt-6 space-y-3" aria-label="Meta problems">
			@partials.ProblemList(list)
		</section>
	}
}
