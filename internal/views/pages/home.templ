package pages

import (
	"github.com/hi-naresh/unsolved/internal/views/layouts"
	"github.com/hi-naresh/unsolved/internal/views/partials"
)

// HomeView is the front page: pinned seed problems, then open problems by score.
type HomeView struct {
	Pinned  []partials.ProblemRowView
	List    partials.ProblemRowsView
	Domains []ProblemDomainOption
}

templ Home(v HomeView) {
	@Explore(ExploreView{
		Title:   "Unsolved problems",
		Heading: "Unsolved problems",
		Sub:     "Real operational problems, ranked by the people who live with them.",
		Tab:     "open",
		Domains: v.Domains,
		Pinned:  v.Pinned,
		List:    v.List,
	})
}

// ExploreView is the two-pane explorer shared by / and /problems: a compact
// list on the left, a live preview of the selected problem on the right.
type ExploreView struct {
	Title   string
	Heading string
	Sub     string
	Tab     string // open | top | new | solved | invalid
	Domain  string // selected domain slug, "" = all
	Domains []ProblemDomainOption
	Pinned  []partials.ProblemRowView
	List    partials.ProblemRowsView
}

func exploreTabURL(tab, domain string) string {
	u := "/problems?"
	switch tab {
	case "open":
		if domain == "" {
			return "/"
		}
		u += "state=open&"
	case "new":
		u += "sort=new&"
	case "solved":
		u += "state=solved&"
	case "invalid":
		u += "state=invalid&"
	default:
		u += "sort=top&"
	}
	if domain != "" {
		u += "domain=" + domain
	}
	return u
}

func ariaCurrent(on bool) string {
	if on {
		return "page"
	}
	return "false"
}

templ Explore(v ExploreView) {
	@layouts.BaseWide(v.Title) {
		if v.Tab == "open" && v.Domain == "" {
   <section class="atlas-intro" aria-label="Welcome to Unsolved">
    <div>
     <h1>Good work deserves<br/>a better way.</h1>
     <p>Share the work still done by hand. Find people who understand it. Discover what actually helps.</p>
     <div class="intro-actions"><a href="/new" class="btn">Share a problem</a><a href="/about" class="btn-ghost">How Unsolved works</a></div>
    </div>
    <div class="atlas-path">
     <ol aria-label="How it works">
      <li><span class="path-icon">1</span><strong>Show the process</strong><span>What happens today?</span></li>
      <li><span class="path-icon">2</span><strong>Find a better way</strong><span>Build on each other's ideas.</span></li>
      <li><span class="path-icon">3</span><strong>Put it to the test</strong><span>Share what worked.</span></li>
     </ol>
    </div>
   </section>
  }
  <div class="explore-workspace">
   <aside class="explore-list" aria-label="Problems">
    <div class="explore-heading">
     if v.Tab == "open" && v.Domain == "" {
      <h2>{ v.Heading }</h2>
     } else {
      <h1 class="text-2xl font-semibold tracking-tight">{ v.Heading }</h1>
     }
     <span>Made better together</span>
    </div>
    <p class="mt-1 text-sm text-stone-500">{ v.Sub }</p>
    <nav class="seg mt-4 flex w-full" aria-label="Sort and filter">
     <a href={ templ.SafeURL(exploreTabURL("open", v.Domain)) } aria-current={ ariaCurrent(v.Tab == "open") } class="flex-1 text-center">Open</a>
     <a href={ templ.SafeURL(exploreTabURL("top", v.Domain)) } aria-current={ ariaCurrent(v.Tab == "top") } class="flex-1 text-center">Top</a>
     <a href={ templ.SafeURL(exploreTabURL("new", v.Domain)) } aria-current={ ariaCurrent(v.Tab == "new") } class="flex-1 text-center">New</a>
     <a href={ templ.SafeURL(exploreTabURL("solved", v.Domain)) } aria-current={ ariaCurrent(v.Tab == "solved") } class="flex-1 text-center">Solved</a>
    </nav>
    <form action="/problems" method="get" class="domain-filter">
     if v.Tab == "new" || v.Tab == "top" {
      <input type="hidden" name="sort" value={ v.Tab }/>
     } else {
      <input type="hidden" name="state" value={ v.Tab }/>
     }
     <label for="explore-domain">Field</label>
     <select id="explore-domain" name="domain">
      <option value="">All fields</option>
      for _, d := range v.Domains {
<option value={ d.Slug } selected?={ v.Domain == d.Slug }>{ d.Name }</option>
}
     </select>
     <button type="submit" class="btn-secondary">Apply</button>
    </form>
    <div class="problem-feed">
     if len(v.Pinned) > 0 {
      <p class="list-section-label">A few places to start</p>
      <ul>
       for _, r := range v.Pinned {
@partials.ProblemRow(r)
}
      </ul>
      if len(v.List.Rows) > 0 {
<p class="list-section-label">From the community</p>
}
     }
     if len(v.List.Rows) > 0 || len(v.Pinned) == 0 || v.List.MoreURL != "" {
      @partials.ProblemList(v.List)
     }
    </div>
   </aside>
   <section class="preview-region" aria-label="Problem preview">
    <div class="preview-shell">
     <div class="preview-label"><span>A closer look</span><span>Use J / K to explore</span></div>
     <div id="pane" aria-live="polite" aria-busy="false">@panePlaceholder()</div>
    </div>
   </section>
  </div>
	}
}

templ domainPill(href, label string, on bool) {
	<a
		href={ templ.SafeURL(href) }
		aria-current={ ariaCurrent(on) }
		class={ "shrink-0 rounded-full border px-3 py-1 text-xs font-medium transition",
			templ.KV("border-accent bg-accent text-white", on),
			templ.KV("border-stone-200 bg-white text-stone-600 hover:border-stone-300 hover:text-stone-900", !on) }
	>{ label }</a>
}

// panePlaceholder shows until app.js loads the first problem into the pane.
templ panePlaceholder() {
	<div class="card grid min-h-[60vh] place-items-center p-10 text-center">
		<div class="max-w-sm">
			<svg class="mx-auto size-24 text-stone-300" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<circle cx="60" cy="60" r="14" class="fill-accent/15 stroke-accent"></circle>
				<circle cx="22" cy="30" r="8"></circle>
				<circle cx="98" cy="34" r="10"></circle>
				<circle cx="94" cy="92" r="7"></circle>
				<circle cx="26" cy="90" r="9"></circle>
				<path d="M48 52 29 36M72 53l17-13M71 69l17 17M48 68 33 84" stroke-dasharray="3 4"></path>
			</svg>
			<p class="mt-4 font-semibold text-stone-800">Pick a problem to see it here</p>
			<p class="mt-1 text-sm text-stone-500">Each problem shows how the work is done today, what goes wrong, and the solutions people have proposed.</p>
		</div>
	</div>
}
