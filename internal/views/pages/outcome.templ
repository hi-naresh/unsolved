package pages

import (
	"github.com/hi-naresh/unsolved/internal/auth"
	"github.com/hi-naresh/unsolved/internal/views/layouts"
	"github.com/hi-naresh/unsolved/internal/views/partials"
)

// OutcomeConfirmView is the /solved/{token} confirm page (the one-tap link
// from the SolvedPrompt email). Opening it changes nothing; the button POSTs.
type OutcomeConfirmView struct {
	Token         string
	ProblemID     string
	SolutionID    string
	Title         string
	Kind          string
	Body          string
	Outcome       string // the outcome picked in the email, or "" to offer all three
	PosterOutcome string // what the poster already recorded, or ""
	Solved        bool   // the problem is already marked solved
}

var outcomeChoices = []string{"worked", "partly", "failed"}

templ OutcomeConfirm(v OutcomeConfirmView) {
	@layouts.Base("Did it work?") {
		<h1 class="text-2xl font-semibold">Did it work?</h1>
		<p class="mt-2 text-stone-700">
			A solution to your problem
			<a href={ templ.SafeURL("/p/" + v.ProblemID) } class="font-medium underline">{ v.Title }</a>
			has enough votes to count as solved.
		</p>
		<section class="mt-6 rounded border border-stone-200 bg-white p-4">
			<p class="text-sm text-stone-500">{ partials.SolutionKindLabel(v.Kind) }</p>
			<p class="mt-2 whitespace-pre-line">{ v.Body }</p>
		</section>
		if v.PosterOutcome != "" {
			<p class="mt-4 text-sm text-stone-600">
				You already said: { partials.OutcomeLabel(v.PosterOutcome) }. Confirming again replaces it.
			</p>
		}
		<form method="post" action={ templ.SafeURL("/solved/" + v.Token) } class="mt-6">
			<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
			if v.Outcome != "" {
				<input type="hidden" name="outcome" value={ v.Outcome }/>
				<button type="submit" class="rounded bg-stone-900 px-4 py-2 text-white hover:bg-stone-700">
					Confirm: { partials.OutcomeLabel(v.Outcome) }
				</button>
				if v.Outcome == "worked" && !v.Solved {
					<p class="mt-2 text-sm text-stone-600">This also marks your problem solved.</p>
				}
			} else {
				<div class="flex flex-wrap gap-2">
					for _, o := range outcomeChoices {
						<button type="submit" name="outcome" value={ o } class="rounded bg-stone-900 px-4 py-2 text-white hover:bg-stone-700">
							{ partials.OutcomeLabel(o) }
						</button>
					}
				</div>
			}
		</form>
		if v.Outcome != "" {
			<p class="mt-6 text-sm text-stone-600">
				Not what you meant?
				for _, o := range outcomeChoices {
					if o != v.Outcome {
						<a href={ templ.SafeURL("/solved/" + v.Token + "?outcome=" + o) } class="ml-2 underline">{ partials.OutcomeLabel(o) }</a>
					}
				}
			</p>
		}
	}
}
