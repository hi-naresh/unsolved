package pages

import (
	"net/url"

	"github.com/hi-naresh/unsolved/internal/views/layouts"
)

func userSignInHref(provider, next string) templ.SafeURL {
	return templ.SafeURL("/auth/" + provider + "/start?next=" + url.QueryEscape(next))
}

// SignIn is the provider chooser. next is already validated as a local path.
templ SignIn(next string) {
	@layouts.Base("Sign in") {
		<div class="mx-auto max-w-sm">
			<h1 class="text-2xl font-semibold">Sign in to Unsolved</h1>
			<p class="mt-3 text-stone-700">
				Reading needs no account. To post, revise or vote, sign in with LinkedIn or X.
				There are no passwords.
			</p>
			<div class="mt-6 flex flex-col gap-3">
				<a href={ userSignInHref("linkedin", next) } class="btn justify-center py-2">Continue with LinkedIn</a>
				<a href={ userSignInHref("x", next) } class="btn justify-center py-2">Continue with X</a>
			</div>
			<p class="mt-6 text-sm text-stone-500">
				From LinkedIn or X we store only your account id and profile link — not your email, contacts or posts.
				You can post anonymously, export your data or delete your account at any time.
				<a href="/privacy" class="underline">Privacy</a>
			</p>
		</div>
	}
}
