package pages

import (
	"github.com/hi-naresh/unsolved/internal/auth"
	"github.com/hi-naresh/unsolved/internal/views/layouts"
	"github.com/hi-naresh/unsolved/internal/views/partials"
)

// ReviseProblemForm is /p/{id}/revise, prefilled from the parent revision.
type ReviseProblemForm struct {
	ProblemID        string
	ParentRevisionID string
	ParentIsCurrent  bool
	DomainName       string
	CurrentProcess   string
	Pain             string
	Tried            string
	Title            string
	WhyNote          string
	Display          string
	Handle           string
	Errors           map[string]string
}

// formWhyNoteSuggestions are one-tap starters for the why-note (forms.js).
var formWhyNoteSuggestions = []string{"Added a missing step", "Made the pain clearer", "Shortened it", "Fixed a mistake"}

templ ReviseProblem(f ReviseProblemForm) {
	@layouts.BaseWide("Revise problem") {
		<div class="mx-auto max-w-6xl sm:pt-3">
			<a href={ templ.SafeURL("/p/" + f.ProblemID) } class="btn-ghost -ml-2.5 text-stone-500">
				<svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				Back to the problem
			</a>
			<header class="mt-2 max-w-2xl">
				<p class="kicker">Revision · { f.DomainName }</p>
				<h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Revise this problem</h1>
				<p class="mt-2 text-[15px] leading-relaxed text-stone-600">
					if f.ParentIsCurrent {
						Your revision starts from the current version.
					} else {
						Your revision starts from an earlier version, not the current one.
					}
					It becomes current only if the community votes it above the current version.
				</p>
			</header>
			@partials.FormErrors(f.Errors)
			<form method="post" action={ templ.SafeURL("/p/" + f.ProblemID + "/revisions") } data-preview-form class="mt-6 grid grid-cols-1 gap-6 lg:mt-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-10">
				<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
				<input type="hidden" name="parent_revision_id" value={ f.ParentRevisionID }/>
				<ol class="steps">
					if _, ok := f.Errors["parent_revision_id"]; ok {
						<li>
							@partials.ProblemFieldError(f.Errors, "parent_revision_id")
						</li>
					}
					@formStep(1, "why_note-label", "What are you improving?", "One short line. Voters see it next to your version.", false) {
						<input id="why_note" type="text" name="why_note" aria-labelledby="why_note-label" required maxlength="500" data-aim="120" value={ f.WhyNote } placeholder="e.g. Added the step where orders are printed" class="field mt-0"/>
						<div class="mt-2 flex flex-wrap gap-1.5">
							for _, s := range formWhyNoteSuggestions {
								<button type="button" class="chip cursor-pointer py-1 transition hover:border-stone-300 hover:text-stone-900" data-fill={ s } data-fill-target="why_note">+ { s }</button>
							}
						</div>
						@formAimMeter("why_note")
						@partials.ProblemFieldError(f.Errors, "why_note")
					}
					@formStep(2, "current_process-label", "How is it done today?", "One step per line — 3 to 6 steps is ideal.", false) {
						<textarea id="current_process" name="current_process" aria-labelledby="current_process-label" rows="6" required minlength="50" maxlength="4000" data-aim="500" class="field field-lined">{ f.CurrentProcess }</textarea>
						@formAimMeter("current_process")
						@partials.ProblemFieldError(f.Errors, "current_process")
					}
					@formStep(3, "pain-label", "What goes wrong?", "One or two sentences. What does it cost?", false) {
						<textarea id="pain" name="pain" aria-labelledby="pain-label" rows="3" required minlength="20" maxlength="2000" data-aim="240" class="field field-lined">{ f.Pain }</textarea>
						@formAimMeter("pain")
						@partials.ProblemFieldError(f.Errors, "pain")
					}
					@formStep(4, "tried-label", "What have you tried?", "Tools, workarounds — or “nothing yet”.", true) {
						<textarea id="tried" name="tried" aria-labelledby="tried-label" rows="2" maxlength="2000" data-aim="240" placeholder="nothing yet" class="field field-lined">{ f.Tried }</textarea>
						@formAimMeter("tried")
						@partials.ProblemFieldError(f.Errors, "tried")
					}
					@formStep(5, "title-label", "Sum it up in one line", "Name the problem, not a fix. Under 80 characters reads best.", false) {
						<input id="title" type="text" name="title" aria-labelledby="title-label" required minlength="10" maxlength="140" data-aim="80" value={ f.Title } class="field mt-0"/>
						@formAimMeter("title")
						@partials.ProblemFieldError(f.Errors, "title")
					}
					<li class="px-1 pt-2">
						<p class="kicker mb-2">Post as</p>
						@partials.ProblemDisplayToggle(f.Handle, f.Display)
						@partials.ProblemFieldError(f.Errors, "display")
					</li>
				</ol>
				<aside class="space-y-4 lg:sticky lg:top-28 lg:self-start" aria-label="Live preview">
					@formPreviewHead(5)
					<details class="form-preview-disclosure" open>
<summary>Preview your problem</summary>
@formProblemPreview(f.DomainName)
</details>
					<button type="submit" class="btn w-full py-2.5 text-[15px]">Submit revision</button>
					<a href={ templ.SafeURL("/p/" + f.ProblemID) } class="btn-ghost w-full justify-center">Cancel</a>
				</aside>
			</form>
		</div>
		<script src="/static/js/forms.js?v=atlas-2" defer></script>
	}
}
