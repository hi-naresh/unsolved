package pages

import (
	"github.com/hi-naresh/unsolved/internal/auth"
	"github.com/hi-naresh/unsolved/internal/views/layouts"
)

// WelcomeForm is the /welcome form state.
type WelcomeForm struct {
	Handle      string
	InDirectory bool
	Next        string
	Errors      map[string]string // field → message
}

// Welcome asks a new member for exactly two things: a handle and whether to
// be listed in the members directory.
templ Welcome(f WelcomeForm) {
	@layouts.Base("Welcome") {
		<div class="mx-auto max-w-md">
			<h1 class="text-2xl font-semibold">Welcome to Unsolved</h1>
			<p class="mt-3 text-stone-700">Two quick choices and you're in.</p>
			<form method="post" action="/welcome" class="mt-6 space-y-6">
				<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
				<input type="hidden" name="next" value={ f.Next }/>
				<div>
					<label for="handle" class="block text-sm font-medium">Handle</label>
					<div class="mt-1 flex items-center gap-1">
						<span class="text-stone-500">{ "@" }</span>
						<input
							id="handle"
							name="handle"
							value={ f.Handle }
							required
							minlength="3"
							maxlength="24"
							pattern="[a-z0-9_]{3,24}"
							autocomplete="off"
							class="field mt-0"
						/>
					</div>
					<p class="mt-1 text-xs text-stone-500">3–24 lowercase letters, digits or underscores. Shown on posts you make under your name.</p>
					if msg, ok := f.Errors["handle"]; ok {
						<p class="error">{ msg }</p>
					}
				</div>
				<div>
					<label class="flex items-start gap-2 text-sm">
						<input type="checkbox" name="in_directory" value="1" checked?={ f.InDirectory } class="mt-0.5"/>
						<span>
							<span class="font-medium">List me in the members directory</span>
							<span class="block text-stone-500">Your profile will then also show your LinkedIn or X link. Off by default.</span>
						</span>
					</label>
				</div>
				<button type="submit" class="btn">Continue</button>
			</form>
		</div>
	}
}
