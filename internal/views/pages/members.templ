package pages

import (
	"net/url"

	"github.com/hi-naresh/unsolved/internal/service"
	"github.com/hi-naresh/unsolved/internal/views/layouts"
)

func userTruncate(s string, n int) string {
	r := []rune(s)
	if len(r) <= n {
		return s
	}
	return string(r[:n]) + "…"
}

// Members is the directory of opted-in users. next is the keyset cursor for
// the following page ("" on the last page).
templ Members(members []service.Member, next string) {
	@layouts.Base("Members") {
		<p class="kicker">Directory</p>
		<h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">People who know the work</h1>
		<p class="mt-2 text-[15px] text-stone-600">People who chose to be listed. Declared histories are unverified.</p>
		@MembersList(members, next)
	}
}

// MembersList is the list plus its "more" link; it is also the htmx partial.
templ MembersList(members []service.Member, next string) {
	if len(members) == 0 {
		<div class="card mt-6 px-6 py-10 text-center">
			<p class="text-sm text-stone-600">Nobody here yet.</p>
			<a href="/settings" class="btn-secondary mt-4">List yourself in settings</a>
		</div>
	} else {
		<ul class="mt-6 grid gap-3 sm:grid-cols-2">
			for _, m := range members {
				<li class="card card-hover member-card relative flex gap-3 p-5">
					<span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-base font-semibold text-accent-ink" aria-hidden="true">{ userInitial(m.DisplayName, m.Handle) }</span>
					<div class="min-w-0 flex-1">
						<a href={ templ.SafeURL("/u/" + m.Handle) } class="block truncate font-medium text-stone-900 after:absolute after:inset-0 after:rounded-xl hover:text-accent">{ m.DisplayName }</a>
						<span class="block truncate text-xs text-stone-500">{ "@" + m.Handle }</span>
						if m.DeclaredHistory != "" {
							<p class="clamp-2 mt-2 text-sm leading-snug text-stone-600">{ userTruncate(m.DeclaredHistory, 200) }</p>
						}
					</div>
				</li>
			}
		</ul>
	}
	if next != "" {
		<div class="mt-6 text-center">
			<a href={ templ.SafeURL("/members?after=" + url.QueryEscape(next)) } class="btn-secondary">More members</a>
		</div>
	}
}
