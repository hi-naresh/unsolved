package pages

import (
	"strconv"

	"github.com/hi-naresh/unsolved/internal/auth"
	"github.com/hi-naresh/unsolved/internal/views"
	"github.com/hi-naresh/unsolved/internal/service"
	"github.com/hi-naresh/unsolved/internal/views/partials"
	"github.com/hi-naresh/unsolved/internal/views/layouts"
)

func userProviderLabel(p string) string {
	switch p {
	case "linkedin":
		return "LinkedIn"
	case "x":
		return "X"
	}
	return p
}

func userContributionVerb(c service.Contribution) string {
	switch {
	case c.Kind == "problem" && c.IsFirst:
		return "Posted problem"
	case c.Kind == "problem":
		return "Revised problem"
	case c.IsFirst:
		return "Proposed a solution to"
	default:
		return "Revised a solution to"
	}
}

// Profile is /u/{handle}. p carries no user id; its contributions are named
// ones only (filtered in the query), and Links is empty unless the user is in
// the directory.
templ Profile(p service.Profile) {
	@layouts.Base("@" + p.Handle) {
		<header>
			<h1 class="text-2xl font-semibold">{ p.DisplayName }</h1>
			<p class="flex items-center gap-3 text-stone-500">
				{ "@" + p.Handle }
				if u := auth.UserFrom(ctx); u != nil && u.Handle != p.Handle {
					@partials.ReportLink("user", p.ReportID)
				}
			</p>
			if p.Suspended {
				<p class="mt-2 text-sm text-amber-800">This account is suspended.</p>
			}
			if len(p.Links) > 0 {
				<ul class="mt-3 flex gap-4 text-sm">
					for _, l := range p.Links {
						<li><a href={ templ.SafeURL(l.URL) } rel="nofollow noopener" class="underline hover:text-stone-600">{ userProviderLabel(l.Provider) }</a></li>
					}
				</ul>
			}
		</header>
		if p.DeclaredHistory != "" {
			if p.DeclaredCollapsed {
				<details class="declared-history mt-6">
					<summary class="cursor-pointer text-sm font-medium text-stone-600">
						Declared history <span class="font-normal text-stone-500">— unverified, carries no weight</span>
					</summary>
					<p class="mt-1 whitespace-pre-line text-stone-800">{ p.DeclaredHistory }</p>
				</details>
			} else {
				<section class="declared-history mt-6">
					<h2 class="text-sm font-medium text-stone-600">
						Declared history <span class="font-normal text-stone-500">— unverified, carries no weight</span>
					</h2>
					<p class="mt-1 whitespace-pre-line text-stone-800">{ p.DeclaredHistory }</p>
				</section>
			}
		}
		@profileStanding(p)
		<section class="mt-8">
			<h2 class="text-lg font-semibold">Contributions</h2>
			if len(p.Contributions) == 0 {
				<p class="mt-2 text-sm text-stone-500">No contributions under this name yet.</p>
			} else {
				<ul class="mt-3 divide-y divide-stone-200">
					for _, c := range p.Contributions {
						<li class="py-3">
							<p class="text-xs text-stone-500">
								{ userContributionVerb(c) } · <time datetime={ c.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ c.CreatedAt.Format("2 Jan 2006") }</time>
							</p>
							<a href={ templ.SafeURL("/p/" + c.ProblemID.String()) } class="font-medium hover:underline">{ c.Title }</a>
						</li>
					}
				</ul>
				if len(p.Contributions) >= 30 {
					<p class="mt-3 text-xs text-stone-500">Showing the 30 most recent.</p>
				}
			}
		</section>
	}
}

func profileHasStanding(p service.Profile) bool {
	for _, d := range p.Domains {
		if profileProvenTier(d.Tier) || d.Vouches > 0 || d.CanVouch || d.ViewerVouched {
			return true
		}
	}
	return false
}

func profileProvenTier(t string) bool { return t == "domain_contributor" || t == "domain_expert" }

func profileVouchText(d service.ProfileDomain) string {
	if d.Vouches == 1 {
		return "Vouched by 1 member in " + d.Name
	}
	return "Vouched by " + strconv.Itoa(d.Vouches) + " members in " + d.Name
}

// profileStanding: earned tiers and vouch counts per domain (counts only,
// never who vouched), and a vouch toggle for eligible viewers.
templ profileStanding(p service.Profile) {
	if profileHasStanding(p) {
		<section class="mt-6" id="vouches">
			<ul class="space-y-1 text-sm text-stone-700">
				for _, d := range p.Domains {
					if profileProvenTier(d.Tier) {
						<li class="standing">{ views.TierLabel(d.Tier) } in { d.Name }</li>
					}
					if d.Vouches > 0 {
						<li class="vouch-count">{ profileVouchText(d) }</li>
					}
				}
			</ul>
			if u := auth.UserFrom(ctx); u != nil && !u.Suspended && !p.ViewerIsSelf {
				<div class="mt-2 flex flex-wrap gap-2">
					for _, d := range p.Domains {
						if d.CanVouch || d.ViewerVouched {
							<form method="post" action={ templ.SafeURL("/u/" + p.Handle + "/vouch") } class="inline">
								<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
								<input type="hidden" name="domain" value={ d.Slug }/>
								if d.ViewerVouched {
									<button type="submit" class="btn-secondary text-xs" aria-pressed="true">{ "Withdraw vouch in " + d.Name }</button>
								} else {
									<button type="submit" class="btn-secondary text-xs" aria-pressed="false">{ "Vouch in " + d.Name }</button>
								}
							</form>
						}
					}
				</div>
			}
		</section>
	}
}
