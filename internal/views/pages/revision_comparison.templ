package pages

import "strconv"

type revisionFieldChange struct {
	Label string
	Before string
	After string
}

func revisionFieldChanges(before, after EvolutionRevision) []revisionFieldChange {
	return []revisionFieldChange{
		{"Title", before.Title, after.Title},
		{"How it's done today", before.CurrentProcess, after.CurrentProcess},
		{"What goes wrong", before.Pain, after.Pain},
		{"Already tried", before.Tried, after.Tried},
	}
}

templ revisionSelectionRule(minVotes int32) {
	<p class="mt-3 text-sm leading-relaxed text-stone-600">
		A revision becomes current when it has at least { strconv.Itoa(int(minVotes)) } votes and a higher community score than the current version. Ties keep the current version. Votes show community support, not verified accuracy.
	</p>
}

templ revisionComparison(revision, parent EvolutionRevision, parentLabel string) {
	<details id={ "compare-" + revision.ID } class="revision-comparison w-full">
		<summary class="btn-secondary my-2 w-fit cursor-pointer">{ "Compare with " + parentLabel }</summary>
		<div class="space-y-4 py-3">
			for _, field := range revisionFieldChanges(parent, revision) {
				<section aria-label={ field.Label }>
					<h3 class="text-sm font-semibold text-stone-900">{ field.Label }</h3>
					if field.Before == field.After {
						<p class="mt-1 text-xs text-stone-500">Unchanged</p>
					} else {
						<dl class="revision-comparison-fields mt-2">
							<div class="rounded-lg border border-stone-200 bg-stone-50 p-3">
								<dt class="text-xs font-semibold text-stone-600">{ "Before · " + parentLabel }</dt>
								<dd class="mt-1 whitespace-pre-wrap text-sm text-stone-700">
									if field.Before == "" {
										<span class="text-stone-500">Not provided</span>
									} else {
										{ field.Before }
									}
								</dd>
							</div>
							<div class="rounded-lg border border-accent/30 bg-accent-soft p-3">
								<dt class="text-xs font-semibold text-accent-ink">This version</dt>
								<dd class="mt-1 whitespace-pre-wrap text-sm text-stone-900">
									if field.After == "" {
										<span class="text-stone-500">Not provided</span>
									} else {
										{ field.After }
									}
								</dd>
							</div>
						</dl>
					}
				</section>
			}
		</div>
	</details>
}
