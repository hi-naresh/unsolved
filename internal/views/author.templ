package views

import "github.com/hi-naresh/unsolved/internal/auth"

func tierChipClass(tier string) string {
	switch tier {
	case "domain_contributor", "domain_expert":
		return "tier author-tier author-tier-proven"
	}
	return "tier author-tier"
}

// Author renders authorship. Named → @handle linking to the profile, with the
// tier as a small chip when it's above member. Anonymous → an "Anonymous" chip
// with the author's tier for that domain, no link. Deleted → "deleted user".
// Styles live in static/css/pages.css (.author-*).
templ Author(row AuthorRef, viewer *auth.User) {
	if row.Anonymous {
		<span class="author author-anon" title="Posted anonymously: the handle is hidden, the standing is shown"><svg class="size-3 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="7" r="3.2"></circle><path d="M3.8 17c.9-3.1 3.3-4.8 6.2-4.8s5.3 1.7 6.2 4.8" stroke-linecap="round"></path></svg>Anonymous <span class="tier">· { TierLabel(row.Tier) }</span></span>
	} else if row.Deleted {
		<span class="author author-deleted">deleted user</span>
	} else {
		<span class="author-named">
			<a class="author" href={ templ.SafeURL("/u/" + row.Handle) }>{ "@" + row.Handle }</a>
			if row.Tier != "" && row.Tier != "member" {
				<span class={ tierChipClass(row.Tier) }>· { TierLabel(row.Tier) }</span>
			}
			if viewer != nil && viewer.Handle == row.Handle {
				<span class="author-you">(you)</span>
			}
		</span>
	}
}
