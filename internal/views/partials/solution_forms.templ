package partials

import "github.com/hi-naresh/unsolved/internal/auth"

// SolutionReviseFormView is the inline solution-revision form (also
// re-rendered alone with errors).
type SolutionReviseFormView struct {
	SolutionID       string
	ParentRevisionID string
	Body             string
	WhyNote          string
	Handle           string
	Display          string
	Errors           map[string]string
}

templ SolutionReviseForm(f SolutionReviseFormView) {
	<form method="post" action={ templ.SafeURL("/s/" + f.SolutionID + "/revisions") } class="mt-2 space-y-2">
		<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
		<input type="hidden" name="parent_revision_id" value={ f.ParentRevisionID }/>
		<label class="block">
			<span class="text-stone-700">Revised solution</span>
			<textarea name="body" rows="6" required minlength="50" maxlength="8000" class="field">{ f.Body }</textarea>
			@ProblemFieldError(f.Errors, "body")
		</label>
		<label class="block">
			<span class="text-stone-700">Why this change?</span>
			<input type="text" name="why_note" required maxlength="500" value={ f.WhyNote } class="field"/>
			@ProblemFieldError(f.Errors, "why_note")
		</label>
		@ProblemFieldError(f.Errors, "parent_revision_id")
		@ProblemDisplayToggle(f.Handle, f.Display)
		<button type="submit" class="btn">Suggest revision</button>
	</form>
}

// SolutionFormView is the post-a-solution form.
type SolutionFormView struct {
	ProblemID string
	Kind      string
	Body      string
	Handle    string
	Display   string
	Errors    map[string]string
}

templ SolutionForm(f SolutionFormView) {
	<form method="post" action={ templ.SafeURL("/p/" + f.ProblemID + "/solutions") } class="space-y-3" id="post-solution">
		<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
		<label class="block text-sm">
			<span class="text-stone-700">What kind of solution?</span>
			<select name="kind" required class="field">
				for _, k := range SolutionKinds {
					<option value={ k } selected?={ f.Kind == k }>{ SolutionKindLabel(k) }</option>
				}
			</select>
			@ProblemFieldError(f.Errors, "kind")
		</label>
		<label class="block text-sm">
			<span class="text-stone-700">Describe it so someone could do it tomorrow</span>
			<textarea name="body" rows="6" required minlength="50" maxlength="8000" class="field">{ f.Body }</textarea>
			@ProblemFieldError(f.Errors, "body")
		</label>
		@ProblemDisplayToggle(f.Handle, f.Display)
		<button type="submit" class="btn">Post solution</button>
	</form>
}
