package partials

import "github.com/hi-naresh/unsolved/internal/auth"

// SolutionReviseFormView is the inline solution-revision form (also
// re-rendered alone with errors).
type SolutionReviseFormView struct {
	SolutionID       string
	ParentRevisionID string
	Body             string
	WhyNote          string
	Handle           string
	Display          string
	Errors           map[string]string
}

templ SolutionReviseForm(f SolutionReviseFormView) {
	<form method="post" action={ templ.SafeURL("/s/" + f.SolutionID + "/revisions") } class="mt-3 space-y-4">
		<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
		<input type="hidden" name="parent_revision_id" value={ f.ParentRevisionID }/>
		<div>
			<label for={ "swhy-" + f.SolutionID } class="block text-sm font-semibold text-stone-900">What are you improving?</label>
			<input id={ "swhy-" + f.SolutionID } type="text" name="why_note" required maxlength="500" value={ f.WhyNote } placeholder="e.g. Added the cost of the tool" class="field"/>
			@ProblemFieldError(f.Errors, "why_note")
		</div>
		<div>
			<label for={ "sbody-" + f.SolutionID } class="block text-sm font-semibold text-stone-900">Revised solution</label>
			<textarea id={ "sbody-" + f.SolutionID } name="body" rows="6" required minlength="50" maxlength="8000" data-aim="600" class="field leading-relaxed">{ f.Body }</textarea>
			@solutionCount("sbody-" + f.SolutionID)
			@ProblemFieldError(f.Errors, "body")
		</div>
		@ProblemFieldError(f.Errors, "parent_revision_id")
		@ProblemDisplayToggle(f.Handle, f.Display)
		<button type="submit" class="btn w-full">Suggest revision</button>
	</form>
}

// SolutionFormView is the post-a-solution form.
type SolutionFormView struct {
	ProblemID string
	Kind      string
	Body      string
	Handle    string
	Display   string
	Errors    map[string]string
}

// solutionKindHint is the one-line explanation under each kind card.
func solutionKindHint(kind string) string {
	switch kind {
	case "process_change":
		return "Change how people work — no new tool"
	case "off_the_shelf":
		return "An existing product already does this"
	case "custom_software":
		return "Something needs to be built"
	case "dont_automate":
		return "It's fine as it is — here's why"
	}
	return ""
}

templ SolutionForm(f SolutionFormView) {
	<form method="post" action={ templ.SafeURL("/p/" + f.ProblemID + "/solutions") } class="space-y-4" id="post-solution">
		<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
		<div role="radiogroup" aria-labelledby="solution-kind-label">
			<p id="solution-kind-label" class="text-sm font-semibold text-stone-900">What kind of solution?</p>
			<div class="mt-2 grid grid-cols-2 gap-2">
				for _, k := range SolutionKinds {
					<label class={ "kind-pick", "kind-" + k }>
						<input type="radio" name="kind" value={ k } required checked?={ f.Kind == k }/>
						<span class="flex items-start gap-1.5 text-[13px] font-semibold leading-tight text-stone-900">
							<span class="kind-dot mt-[4px] shrink-0"></span>
							{ SolutionKindLabel(k) }
						</span>
						<span class="text-xs leading-snug text-stone-500">{ solutionKindHint(k) }</span>
					</label>
				}
			</div>
			@ProblemFieldError(f.Errors, "kind")
		</div>
		<div>
			<label for={ "solution-body-" + f.ProblemID } class="block text-sm font-semibold text-stone-900">Describe it so someone could do it tomorrow</label>
			<p class="hint">Short steps beat long paragraphs. Name the tool, the cost and who does what.</p>
			<textarea id={ "solution-body-" + f.ProblemID } name="body" rows="6" required minlength="50" maxlength="8000" data-aim="600" class="field leading-relaxed">{ f.Body }</textarea>
			@solutionCount("solution-body-" + f.ProblemID)
			@ProblemFieldError(f.Errors, "body")
		</div>
		@ProblemDisplayToggle(f.Handle, f.Display)
		<button type="submit" class="btn w-full">Post solution</button>
	</form>
}

// solutionCount is the length counter app.js fills for a data-aim field.
templ solutionCount(id string) {
	<p class="mt-1 text-right text-xs text-stone-500 tabular-nums" id={ id + "-count" }>Aim for about 600 characters</p>
}
