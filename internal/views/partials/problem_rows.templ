package partials

import "strconv"

// ProblemList is a full list: the <ul> around the first page of rows.
templ ProblemList(v ProblemRowsView) {
	if len(v.Rows) == 0 && v.MoreURL == "" {
		<div class="rounded-xl border border-dashed border-stone-300 px-6 py-10 text-center">
			<p class="font-medium text-stone-700">{ v.Empty }</p>
			<p class="mt-1 text-sm text-stone-500">Know a process that wastes hours every week?</p>
			<a href="/new" class="btn mt-4">Post a problem</a>
		</div>
	} else {
		<ul class="space-y-1" id="problem-list">
			@ProblemRows(v)
		</ul>
	}
}

// ProblemRows is the htmx partial for a list page: just the <li> rows plus
// the "more" row, which swaps itself for the next page.
templ ProblemRows(v ProblemRowsView) {
	for _, row := range v.Rows {
		@ProblemRow(row)
	}
	if v.MoreURL != "" {
		@Pager(v.MoreURL)
	}
}

// ProblemRow is one problem card. On wide screens app.js opens it in the
// explorer's preview pane; otherwise it is a normal link.
templ ProblemRow(p ProblemRowView) {
	<li data-problem-id={ p.ID }>
		<a href={ templ.SafeURL("/p/" + p.ID) } data-pane-link={ p.ID } class="pcard group">
			<div class="flex flex-wrap items-center gap-1.5">
				if p.Pinned {
					<span class="chip chip-pinned">Start here</span>
				}
				<span class="chip">{ p.DomainName }</span>
				if p.State != "open" {
					<span class={ StateChip(p.State) }>{ ProblemStateLabel(p.State) }</span>
				} else if p.SoftSolved {
					<span class="chip chip-solved" title="The top solution has enough votes">
						<svg class="size-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z"></path></svg>
						Likely solved
					</span>
				}
			</div>
			<h3 class="clamp-2 mt-1.5 text-[15px] font-semibold leading-snug text-stone-900 group-hover:text-accent">{ p.Title }</h3>
			if p.Excerpt != "" {
				<p class="clamp-2 mt-1 text-sm leading-snug text-stone-500">{ p.Excerpt }</p>
			}
			<div class="mt-2 flex items-center gap-3 text-xs text-stone-500">
				<span class="inline-flex items-center gap-1 font-medium tabular-nums text-stone-700" title="Votes on the current version">
					<svg class="size-3.5 text-amber-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 3.5 17 12H3l7-8.5Z"></path></svg>
					{ strconv.Itoa(int(p.Votes)) }
				</span>
				<span class="inline-flex items-center gap-1 tabular-nums" title="Solutions">
					<svg class="size-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7.5 16.5h5M8 13.5a5 5 0 1 1 4 0v1H8v-1Z" stroke-linejoin="round"></path></svg>
					{ strconv.Itoa(int(p.Solutions)) }
					if p.Solutions == 1 {
						solution
					} else {
						solutions
					}
				</span>
				<span class="ml-auto truncate">{ AuthorText(p.Author) } · { Ago(p.CreatedAt) }</span>
			</div>
		</a>
	</li>
}
