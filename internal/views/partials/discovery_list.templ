package partials

import (
	"strconv"

	"github.com/hi-naresh/unsolved/internal/auth"
	"github.com/hi-naresh/unsolved/internal/views"
)

// ProblemLink is one problem in a discovery list (search, trending,
// duplicate hint). Authorship is an AuthorRef only; no author id.
type ProblemLink struct {
	ProblemID string
	Title     string
	Domain    string
	Solved    bool
	Author    views.AuthorRef
	// Similarity is the search match (0–1); 0 hides the meter (trending).
	Similarity float32
}

func (p ProblemLink) URL() templ.SafeURL { return templ.SafeURL("/p/" + p.ProblemID) }

// MatchPercent is Similarity as a whole percentage, clamped to 0–100.
func (p ProblemLink) MatchPercent() int {
	v := int(p.Similarity*100 + 0.5)
	if v < 0 {
		return 0
	}
	if v > 100 {
		return 100
	}
	return v
}

// SearchView is everything the /search page and its htmx partial show.
type SearchView struct {
	Query       string
	Results     []ProblemLink
	Unavailable bool // ML down/disabled: show a note and trending instead
	Trending    []ProblemLink
}

func discoveryResultCount(n int) string {
	if n == 1 {
		return "1 close match"
	}
	return strconv.Itoa(n) + " close matches"
}

// DiscoverySearchResults is the swappable body of /search (the htmx partial).
templ DiscoverySearchResults(v SearchView) {
	<div id="search-results" aria-live="polite">
		if v.Query != "" && !v.Unavailable {
			<div class="flex items-baseline justify-between gap-3">
				<h2 class="min-w-0 truncate text-base font-semibold">Results for “{ v.Query }”</h2>
				if len(v.Results) > 0 {
					<span class="shrink-0 text-xs text-stone-500">{ discoveryResultCount(len(v.Results)) }</span>
				}
			</div>
			if len(v.Results) == 0 {
				<div class="card mt-3 flex flex-col items-center px-6 py-10 text-center">
					<span class="grid size-11 place-items-center rounded-full bg-stone-100 text-stone-500">
						<svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6"></circle><path d="m14 14 4 4M7 9h4" stroke-linecap="round"></path></svg>
					</span>
					<p class="mt-3 max-w-sm text-sm text-stone-600">Nothing close to that yet. Try describing the process in other words, or post it as a new problem.</p>
					<a href="/new" class="btn mt-4">Post it as a problem</a>
				</div>
			} else {
				@DiscoveryProblemList(v.Results)
			}
		} else {
			if v.Unavailable {
				<p class="mb-6 flex items-start gap-2.5 rounded-xl border border-amber-500/25 bg-amber-500/10 px-3.5 py-3 text-sm text-amber-800 dark:text-amber-300" role="status">
					<svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="7.5"></circle><path d="M10 6v4.5M10 13.5v.01" stroke-linecap="round"></path></svg>
					<span>Search is unavailable right now. Try again shortly. Trending problems are shown below.</span>
				</p>
			}
			<div class="flex items-center gap-2">
				<svg class="size-4 text-accent" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 14l4.5-4.5 3 3L17 6M12.5 6H17v4.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				<h2 class="text-base font-semibold">Trending this week</h2>
			</div>
			if len(v.Trending) == 0 {
				<div class="card mt-3 px-6 py-8 text-center">
					<p class="text-sm text-stone-600">Nothing is trending yet. Votes and new revisions this week will show up here.</p>
					<a href="/" class="btn-secondary mt-4">Explore open problems</a>
				</div>
			} else {
				@DiscoveryTrendingList(v.Trending)
			}
		}
	</div>
}

// DiscoveryProblemList is a list of compact problem cards (search results).
templ DiscoveryProblemList(items []ProblemLink) {
	<ul class="mt-3 space-y-2">
		for _, it := range items {
			<li class="card card-hover relative px-5 py-5">
				<a href={ it.URL() } class="block font-medium leading-snug text-stone-900 after:absolute after:inset-0 after:rounded-xl hover:text-accent">{ it.Title }</a>
				<div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs text-stone-500">
					@discoveryChips(it)
					<span class="relative z-10">
						@views.Author(it.Author, auth.UserFrom(ctx))
					</span>
					if it.Similarity > 0 {
						<span class="ml-auto inline-flex items-center gap-1.5" title="How closely this matches your words">
							<span class="meter" aria-hidden="true"><span style={ "width:" + strconv.Itoa(it.MatchPercent()) + "%" }></span></span>
							<span class="tabular-nums">{ strconv.Itoa(it.MatchPercent()) }% match</span>
						</span>
					}
				</div>
			</li>
		}
	</ul>
}

templ discoveryChips(it ProblemLink) {
	if it.Domain != "" {
		<span class="chip">{ it.Domain }</span>
	}
	if it.Solved {
		<span class="chip chip-solved">Solved</span>
	} else {
		<span class="chip chip-open">Open</span>
	}
}

// DiscoveryTrendingList is the ranked "Trending this week" list.
templ DiscoveryTrendingList(items []ProblemLink) {
	<ol class="card mt-3 divide-y divide-stone-200 overflow-hidden">
		for i, it := range items {
			<li>
				<div class="relative flex items-start gap-3 px-4 py-3 transition hover:bg-stone-50">
					<span class="rank pt-0.5" aria-hidden="true">{ strconv.Itoa(i + 1) }</span>
					<div class="min-w-0 flex-1">
						<a href={ it.URL() } class="block font-medium leading-snug text-stone-900 after:absolute after:inset-0 hover:text-accent">{ it.Title }</a>
						<div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-stone-500">
							@discoveryChips(it)
							<span class="relative z-10">
								@views.Author(it.Author, auth.UserFrom(ctx))
							</span>
						</div>
					</div>
				</div>
			</li>
		}
	</ol>
}
