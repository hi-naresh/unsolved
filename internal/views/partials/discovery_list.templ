package partials

import (
	"github.com/hi-naresh/unsolved/internal/auth"
	"github.com/hi-naresh/unsolved/internal/views"
)

// ProblemLink is one problem in a discovery list (search, trending,
// duplicate hint). Authorship is an AuthorRef only; no author id.
type ProblemLink struct {
	ProblemID string
	Title     string
	Domain    string
	Solved    bool
	Author    views.AuthorRef
}

func (p ProblemLink) URL() templ.SafeURL { return templ.SafeURL("/p/" + p.ProblemID) }

// SearchView is everything the /search page and its htmx partial show.
type SearchView struct {
	Query       string
	Results     []ProblemLink
	Unavailable bool // ML down/disabled: show a note and trending instead
	Trending    []ProblemLink
}

// DiscoverySearchResults is the swappable body of /search (the htmx partial).
templ DiscoverySearchResults(v SearchView) {
	<div id="search-results">
		if v.Query != "" && !v.Unavailable {
			<h2 class="text-lg font-semibold">Results for “{ v.Query }”</h2>
			if len(v.Results) == 0 {
				<p class="mt-3 text-stone-600">Nothing close to that yet. Try describing the process in other words, or post it as a new problem.</p>
			} else {
				@DiscoveryProblemList(v.Results)
			}
		} else {
			if v.Unavailable {
				<p class="mb-6 rounded border border-stone-200 bg-white p-3 text-sm text-stone-600">Search is taking a break right now. Here's what's trending instead.</p>
			}
			<h2 class="text-lg font-semibold">Trending this week</h2>
			if len(v.Trending) == 0 {
				<p class="mt-3 text-stone-600">Nothing is trending yet.</p>
			} else {
				@DiscoveryProblemList(v.Trending)
			}
		}
	</div>
}

templ DiscoveryProblemList(items []ProblemLink) {
	<ul class="mt-3 divide-y divide-stone-200 rounded border border-stone-200 bg-white">
		for _, it := range items {
			<li class="px-4 py-3">
				<a href={ it.URL() } class="font-medium hover:underline">{ it.Title }</a>
				if it.Solved {
					<span class="ml-2 rounded bg-green-100 px-1.5 py-0.5 text-xs text-green-800">Solved</span>
				}
				<div class="mt-1 text-sm text-stone-500">
					{ it.Domain } ·
					@views.Author(it.Author, auth.UserFrom(ctx))
				</div>
			</li>
		}
	</ul>
}
