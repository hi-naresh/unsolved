package partials

import (
	"github.com/hi-naresh/unsolved/internal/auth"
	"github.com/hi-naresh/unsolved/internal/views"
	"strconv"
)

// SolutionCard is one solution on the problem page: kind, current revision,
// author, vote, "tried it" outcomes and form, and the inline revision form.
templ SolutionCard(s SolutionView) {
	<article class="rounded border border-stone-200 bg-white p-4" id={ "s-" + s.ID }>
		<div class="flex items-start gap-3">
			@VoteButton(s.Vote)
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-center gap-x-2 text-xs text-stone-500">
					<span class="rounded bg-stone-100 px-1.5 py-0.5 font-medium text-stone-700">{ SolutionKindLabel(s.Kind) }</span>
					@views.Author(s.Author, auth.UserFrom(ctx))
					if s.IsRevised {
						<span>· revised</span>
					}
					if auth.UserFrom(ctx) != nil {
						<span class="flex-1"></span>
						@ReportLink("solution_revision", s.RevisionID)
					}
				</div>
				<div class="mt-2 whitespace-pre-line text-stone-800">{ s.Body }</div>
				<p class="mt-3 text-sm text-stone-600">
					Tried it:
					<span class="tabular-nums">{ strconv.FormatInt(s.Worked, 10) } worked</span> ·
					<span class="tabular-nums">{ strconv.FormatInt(s.Partly, 10) } partly</span> ·
					<span class="tabular-nums">{ strconv.FormatInt(s.Failed, 10) } didn't work</span>
				</p>
				if len(s.Notes) > 0 {
					<ul class="mt-2 space-y-1 text-sm text-stone-600">
						for _, n := range s.Notes {
							<li><span class="font-medium">{ OutcomeLabel(n.Outcome) }:</span> { n.Note }</li>
						}
					</ul>
				}
				if s.CanWrite {
					<details class="mt-3 text-sm">
						<summary class="cursor-pointer text-stone-600 hover:underline">
							if s.ViewerOutcome != "" {
								You tried it ({ OutcomeLabel(s.ViewerOutcome) }) · change
							} else {
								I tried it
							}
						</summary>
						<form method="post" action={ templ.SafeURL("/s/" + s.ID + "/tried") } class="mt-2 space-y-2">
							<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
							<fieldset class="flex flex-wrap gap-4">
								<legend class="sr-only">Outcome</legend>
								for _, o := range []string{"worked", "partly", "failed"} {
									<label class="inline-flex items-center gap-1.5">
										<input type="radio" name="outcome" value={ o } required checked?={ s.ViewerOutcome == o }/>
										{ OutcomeLabel(o) }
									</label>
								}
							</fieldset>
							<textarea name="note" rows="2" maxlength="1000" class="field" placeholder="What happened? (optional)"></textarea>
							<button type="submit" class="btn">Save outcome</button>
						</form>
					</details>
					<details class="mt-2 text-sm">
						<summary class="cursor-pointer text-stone-600 hover:underline">Suggest a revision</summary>
						@SolutionReviseForm(SolutionReviseFormView{
							SolutionID: s.ID, ParentRevisionID: s.RevisionID, Body: s.Body,
							Handle: s.Handle, Display: s.Display,
						})
					</details>
				}
			</div>
		</div>
	</article>
}
