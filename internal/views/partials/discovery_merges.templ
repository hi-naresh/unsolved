package partials

import (
	"fmt"

	"github.com/hi-naresh/unsolved/internal/auth"
)

// MergeRow is one admin merge suggestion.
type MergeRow struct {
	ID         string
	Similarity float32
	ProblemA   string
	TitleA     string
	ProblemB   string
	TitleB     string
}

func mergePercent(s float32) string { return fmt.Sprintf("%.0f", s*100) }

// DiscoveryMerges is the /admin/merges list; Next is the ?after= cursor.
templ DiscoveryMerges(rows []MergeRow, next string) {
	<div id="merges">
		if len(rows) == 0 {
			<div class="card mt-6 px-6 py-10 text-center">
				<p class="text-sm text-stone-600">No open merge suggestions.</p>
				<a href="/admin" class="btn-secondary mt-4">Back to reports</a>
			</div>
		} else {
			<ul class="mt-6 space-y-3">
				for _, m := range rows {
					@DiscoveryMergeRow(m)
				}
			</ul>
			if next != "" {
				<a class="btn-secondary mt-6" href={ templ.SafeURL("/admin/merges?after=" + next) }>Next page →</a>
			}
		}
	</div>
}

templ DiscoveryMergeRow(m MergeRow) {
	<li class="card p-3 sm:p-4" id={ "merge-" + m.ID }>
		<div class="flex items-center justify-between gap-3">
			<span class="inline-flex items-center gap-2 text-xs text-stone-500">
				<span class="meter w-20" aria-hidden="true"><span style={ "width:" + mergePercent(m.Similarity) + "%" }></span></span>
				<span class="font-medium tabular-nums text-stone-700">{ fmt.Sprintf("%.0f%% similar", m.Similarity*100) }</span>
			</span>
			<form
				method="post"
				action={ templ.SafeURL("/admin/merges/" + m.ID + "/dismiss") }
				hx-post={ "/admin/merges/" + m.ID + "/dismiss" }
				hx-target={ "#merge-" + m.ID }
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
				<button type="submit" class="btn-ghost text-xs" title="Not duplicates: never suggest this pair again">
					<svg class="size-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke-linecap="round"></path></svg>
					Dismiss
				</button>
			</form>
		</div>
		<div class="relative mt-3 grid gap-2 sm:grid-cols-2 sm:gap-3">
			<a class="rounded-lg border border-stone-200 bg-stone-50 px-3 py-2.5 text-sm font-medium leading-snug text-stone-900 transition hover:border-accent/50 hover:text-accent" href={ templ.SafeURL("/p/" + m.ProblemA) }>
				<span class="kicker block">A</span>
				{ m.TitleA }
			</a>
			<span class="pointer-events-none absolute left-1/2 top-1/2 hidden size-7 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-stone-200 bg-white text-xs font-semibold text-stone-500 sm:grid" aria-hidden="true">≈</span>
			<a class="rounded-lg border border-stone-200 bg-stone-50 px-3 py-2.5 text-sm font-medium leading-snug text-stone-900 transition hover:border-accent/50 hover:text-accent" href={ templ.SafeURL("/p/" + m.ProblemB) }>
				<span class="kicker block">B</span>
				{ m.TitleB }
			</a>
		</div>
	</li>
}
