package partials

import (
	"github.com/hi-naresh/unsolved/internal/auth"
	"strconv"
)

const voteBase = "group/vote flex w-11 shrink-0 flex-col items-center justify-center rounded-lg border py-1.5 text-sm font-semibold tabular-nums leading-none transition"

func voteLabel(v VoteButtonView) string {
	action := "Upvote this version"
	if v.Voted {
		action = "Remove your vote"
	}
	return action + "; " + strconv.Itoa(int(v.Count)) + " votes"
}

templ voteArrow() {
	<svg class="size-4 transition group-active/vote:-translate-y-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 3.5 17 12H3l7-8.5Z"></path></svg>
}

// VoteButton is the vote toggle. Without JS it is a plain form POST (the
// server redirects back to the problem page); with htmx the button posts and
// the response replaces the enclosing form.
templ VoteButton(v VoteButtonView) {
	switch v.Mode {
		case VoteLive:
			<form method="post" action={ templ.SafeURL(v.URL) } class="vote">
				<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
				<button
					type="submit"
					hx-post={ v.URL }
					hx-target="closest form"
					hx-swap="outerHTML"
					aria-pressed={ strconv.FormatBool(v.Voted) }
					title="Upvote"
					aria-label={ voteLabel(v) }
					class={ voteBase, "border-stone-200 bg-white text-stone-500 hover:border-amber-400 hover:text-amber-600 [&.voted]:border-amber-400 [&.voted]:bg-amber-500/12 [&.voted]:text-amber-600", templ.KV("voted", v.Voted) }
				>
					@voteArrow()
					<span class="mt-1 text-stone-800 group-[.voted]/vote:text-amber-700"><span class="vote-count">{ strconv.Itoa(int(v.Count)) }</span></span>
				</button>
			</form>
		case VoteSignIn:
			<a href={ templ.SafeURL(v.SignInURL) } class={ voteBase, "border-stone-200 bg-white text-stone-400 hover:border-amber-400 hover:text-amber-600" } title="Sign in to vote">
				@voteArrow()
				<span class="mt-1 text-stone-800"><span class="vote-count">{ strconv.Itoa(int(v.Count)) }</span></span>
			</a>
		default:
			<span class={ voteBase, "border-stone-200 bg-stone-50 text-stone-300" } title={ v.Note }>
				@voteArrow()
				<span class="mt-1 text-stone-600"><span class="vote-count">{ strconv.Itoa(int(v.Count)) }</span></span>
			</span>
	}
}
