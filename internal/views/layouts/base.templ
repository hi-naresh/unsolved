package layouts

import "github.com/hi-naresh/unsolved/internal/auth"

// Base is the full-page layout for reading and form pages (narrow column).
// hx-headers on <body> makes every htmx request carry the CSRF token.
templ Base(title string) {
	@shell(title, false) {
		{ children... }
	}
}

// BaseWide is the layout for split-pane pages (explorer, problem page).
templ BaseWide(title string) {
	@shell(title, true) {
		{ children... }
	}
}

templ shell(title string, wide bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ title } · Unsolved</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234f46e5'/%3E%3Cpath d='M10 9v8a6 6 0 0 0 12 0V9' stroke='white' stroke-width='3.2' fill='none' stroke-linecap='round'/%3E%3C/svg%3E"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/js/app.js" defer></script>
		</head>
		<body class="min-h-screen bg-stone-50 text-stone-900 antialiased" hx-headers={ `{"X-CSRF-Token": "` + auth.CSRFToken(ctx) + `"}` }>
			<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
			@nav(auth.UserFrom(ctx))
			if wide {
				<main id="main" class="mx-auto max-w-7xl px-4 py-5 sm:px-6">
					{ children... }
				</main>
			} else {
				<main id="main" class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
					{ children... }
				</main>
			}
			<footer class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-5 gap-y-2 px-4 py-10 text-sm text-stone-500 sm:px-6">
				<span class="flex items-center gap-2 font-medium text-stone-600">@logo("size-5") Unsolved</span>
				<a href="/about" class="hover:text-stone-900">How it works</a>
				<a href="/privacy" class="hover:text-stone-900">Privacy</a>
				<a href="/meta" class="hover:text-stone-900">Meta board</a>
				<a href="/members" class="hover:text-stone-900">Members</a>
			</footer>
		</body>
	</html>
}

templ logo(class string) {
	<svg class={ class } viewBox="0 0 32 32" aria-hidden="true">
		<rect width="32" height="32" rx="8" class="fill-accent"></rect>
		<path d="M10 9v8a6 6 0 0 0 12 0V9" stroke="white" stroke-width="3.2" fill="none" stroke-linecap="round"></path>
	</svg>
}

templ nav(u *auth.User) {
	<header class="sticky top-0 z-30 border-b border-stone-200/80 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
		<nav class="mx-auto flex h-14 max-w-7xl items-center gap-2 px-4 sm:gap-4 sm:px-6" aria-label="Main">
			<a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
				@logo("size-7")
				<span class="hidden sm:inline">Unsolved</span>
			</a>
			<div class="ml-2 hidden items-center gap-1 md:flex">
				<a href="/" class="btn-ghost">Explore</a>
				<a href="/problems?state=solved" class="btn-ghost">Solved</a>
				<a href="/meta" class="btn-ghost">Meta</a>
			</div>
			<form action="/search" method="get" role="search" class="relative ml-auto w-full max-w-xs">
				<svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-stone-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6"></circle><path d="m14 14 4 4" stroke-linecap="round"></path></svg>
				<input type="search" name="q" placeholder="Search problems…" aria-label="Search problems" class="h-9 w-full rounded-lg border border-stone-200 bg-stone-50 pl-8 pr-3 text-sm placeholder:text-stone-400 focus:border-accent focus:bg-white focus:outline-none focus:ring-4 focus:ring-accent/15"/>
			</form>
			if u == nil {
				<a href="/signin" class="btn shrink-0">Sign in</a>
			} else {
				<a href="/new" class="btn shrink-0" title="Post a problem">
					<svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z"></path></svg>
					<span class="hidden sm:inline">Post a problem</span>
				</a>
				<details class="relative shrink-0">
					<summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full bg-accent-soft text-sm font-semibold uppercase text-accent-ink [&::-webkit-details-marker]:hidden" aria-label="Account menu">{ initial(u.Handle) }</summary>
					<div class="card absolute right-0 mt-2 w-52 p-1.5 text-sm" style="box-shadow: var(--u-shadow-lg)">
						<p class="truncate px-2.5 py-1.5 text-stone-500">{ "@" + u.Handle }</p>
						<a href={ templ.SafeURL("/u/" + u.Handle) } class="block rounded-md px-2.5 py-1.5 hover:bg-stone-100">Your profile</a>
						<a href="/settings" class="block rounded-md px-2.5 py-1.5 hover:bg-stone-100">Settings</a>
						if u.IsAdmin {
							<a href="/admin" class="block rounded-md px-2.5 py-1.5 hover:bg-stone-100">Admin</a>
						}
						<form method="post" action="/auth/signout" class="border-t border-stone-200 pt-1 mt-1">
							<input type="hidden" name="csrf_token" value={ auth.CSRFToken(ctx) }/>
							<button type="submit" class="w-full rounded-md px-2.5 py-1.5 text-left hover:bg-stone-100">Sign out</button>
						</form>
					</div>
				</details>
			}
		</nav>
	</header>
}

func initial(h string) string {
	if h == "" {
		return "?"
	}
	return h[:1]
}
