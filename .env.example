# Copy to .env for local development. Production values live in Fly secrets.
DATABASE_URL=postgres://unsolved:unsolved@localhost:5432/unsolved?sslmode=disable
BASE_URL=http://localhost:8080
SESSION_TTL=720h
# Leave providers empty until configured. See docs/AUTH-SETUP.md.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a real operator contact; see docs/AUTH-SETUP.md.
REDDIT_USER_AGENT=
POSTMARK_TOKEN=replace-me
RANK_HALF_LIFE=720h
# Private in production (Fly secrets only). Placeholders here.
RANK_MIN_VOTES_TO_TAKE_OVER=3
SOFT_SOLVED_THRESHOLD=5
RANK_WEIGHTS_JSON={}
# Phase 5
ML_URL=http://localhost:8000
SENTRY_DSN=
ADMIN_HANDLES=
